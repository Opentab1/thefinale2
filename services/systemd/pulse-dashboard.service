[Unit]
Description=Pulse Dashboard - Web Interface
After=network.target pulse-hub.service
Requires=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pulse/dashboard/api
Environment="PYTHONPATH=/opt/pulse"
Environment="PULSE_SIO_MODE=threading"
ExecStart=/opt/pulse/venv/bin/python3 /opt/pulse/dashboard/api/server.py
Restart=always
RestartSec=10
TimeoutStartSec=30

# Logging
StandardOutput=append:/var/log/pulse/dashboard.log
StandardError=append:/var/log/pulse/dashboard-error.log

[Install]
WantedBy=multi-user.target
