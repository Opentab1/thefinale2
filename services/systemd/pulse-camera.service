[Unit]
Description=Pulse Camera Service (People Counter)
After=network.target
Requires=network.target
PartOf=pulse.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pulse
Environment="PYTHONPATH=/opt/pulse:/opt/pulse/services"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/pulse/venv/bin/python3 /opt/pulse/run_camera_service.py
Restart=always
RestartSec=5
TimeoutStartSec=30

# Logging
StandardOutput=append:/var/log/pulse/pulse-camera.log
StandardError=append:/var/log/pulse/pulse-camera-error.log

# Resource limits
MemoryLimit=512M

[Install]
WantedBy=multi-user.target pulse.service
