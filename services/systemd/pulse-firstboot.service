[Unit]
Description=Pulse First Boot Setup Wizard
After=network.target
ConditionPathExists=!/opt/pulse/config/.wizard_complete

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pulse
ExecStart=/opt/pulse/venv/bin/python3 /opt/pulse/bootstrap/wizard/server.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
