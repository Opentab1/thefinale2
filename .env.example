# Pulse 1.0 Environment Configuration

# Google Nest / SDM API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
NEST_DEVICE_ID=

# Philips Hue
HUE_BRIDGE_IP=
HUE_USERNAME=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:9090/callback/spotify

# Security
SECRET_KEY=
ENCRYPTION_KEY=

# Database
DATABASE_URL=sqlite:////opt/pulse/data/pulse.db

# Dashboard
DASHBOARD_PORT=8080
WIZARD_PORT=9090

# Song detection (optional)
SONG_DETECT_PROVIDER=shazam
# AudD (if using provider=audd)
AUDD_API_TOKEN=
# ACRCloud (if using provider=acrcloud)
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
SONG_DETECT_INTERVAL_SEC=15
DB_UPDATE_INTERVAL_SEC=60
LIGHT_UPDATE_INTERVAL_SEC=30
PULSE_LIGHT_SOURCE=snapshot
